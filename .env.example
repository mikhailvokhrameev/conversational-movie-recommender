# Secrets and deployment wiring ONLY.
#
# Model names, scoring weights, and every other tuning value live in
# params.yaml. Nothing here overrides them -- if you are looking for where to
# change a model or a weight, it is params.yaml.

# Database
DB_PASSWORD=changeme

# Django
SECRET_KEY=change-in-production
DEBUG=1

# Inference mode is selected by the Compose launch files (local by default).
# For host commands: local or openrouter; no automatic provider fallback.
INFERENCE_MODE=local
# Required for OpenRouter; passed only to the backend in the cloud launch.
OPENROUTER_API_KEY=
# Parameter file path inside the backend container (host commands may override).
PARAMS_PATH=/app/params.yaml
